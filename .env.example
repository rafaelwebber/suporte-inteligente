# Preserve o .env do destino. Este arquivo é somente uma referência.
FLASK_SECRET_KEY=defina-uma-chave-secreta-propria
FLASK_DEBUG=false
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_WEB_API_KEY=

# Sem estes caminhos opcionais, a aplicação usa instance/ dentro do projeto.
# KNOWLEDGE_DATABASE=C:/caminho/suporte-inteligente/instance/knowledge.sqlite3
# KNOWLEDGE_SEARCH_DATABASE=C:/caminho/suporte-inteligente/instance/search.sqlite3
# KNOWLEDGE_MODEL_DIR=C:/caminho/suporte-inteligente/instance/models/multilingual-e5-small
# Conversas e métricas persistidas (SQLite); por padrão, instance/conversations.sqlite3.
# KNOWLEDGE_CONVERSATION_DATABASE=C:/caminho/suporte-inteligente/instance/conversations.sqlite3
KNOWLEDGE_EMBEDDING_THREADS=2
KNOWLEDGE_MIN_SIMILARITY=0.85

# Provedor da triagem e da orientação. Use openai para ativar o GPT.
KNOWLEDGE_LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# Configuração usada quando KNOWLEDGE_LLM_PROVIDER=gemini.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
